type AuditMetadata @annotate(name: "Serializable", type: "serialization") {
    createdDate: Instant!
    lastModifiedDate: Instant!
    createdBy: String
    lastModifiedBy: String
}

enum EventType {
    CREATED
    UPDATED
    DELETED
}


## Directives

"Custom Annotation"
directive @annotate(
    name: String!
    type: String
    inputs: Json
    target: String
) repeatable on OBJECT | FIELD_DEFINITION | INPUT_OBJECT | INPUT_FIELD_DEFINITION