# Copy to .env (which git ignores).
#
# Which half of compose.yaml runs: `dev` mounts the checkout, compiles it and runs the jar, `prod` builds
# the executable jar into an image. Exactly one.
COMPOSE_PROFILES=dev

# The hostname is demo-api.$HOST. Every *.localhost resolves to this machine with nothing in
# /etc/hosts. A shell that exports HOST or a TRAEFIK_* variable wins over these.
HOST=localhost
TRAEFIK_ENABLE=true
TRAEFIK_HTTP_ENTRYPOINTS=web
TRAEFIK_USE_TLS=false
