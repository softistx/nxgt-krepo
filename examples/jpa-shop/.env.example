# Copy to .env (which git ignores) and fill the two CHANGE_ME.
#
# Which half of compose.yaml runs: `dev` mounts the checkout and runs `./kotlin run`, `prod` builds
# the executable jar into an image. Exactly one.
COMPOSE_PROFILES=dev

# The workspace's Postgres, reached by its alias on the `proxy` network, and its superuser —
# used once, by `db-init`, to create the role and database below. The password is the one in
# nxgt-docker's database/postgres/.env.
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# What the shop connects as. `db-init` creates the role and the database, and sets this password
# on every `up`.   openssl rand -hex 24
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=CHANGE_ME

# The hostname is jpa-shop.$HOST. Every *.localhost resolves to this machine with nothing in
# /etc/hosts. A shell that exports HOST or a TRAEFIK_* variable wins over these.
HOST=localhost
TRAEFIK_ENABLE=true
TRAEFIK_HTTP_ENTRYPOINTS=web
TRAEFIK_USE_TLS=false
