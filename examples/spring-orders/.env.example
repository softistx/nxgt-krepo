# Copy to .env (which git ignores) and fill the two CHANGE_ME.
#
# Which half of compose.yaml runs: `dev` mounts the checkout and runs `./kotlin run`, `prod` builds
# the executable jar into an image. Exactly one.
COMPOSE_PROFILES=dev

# The workspace's replica set, by its members' aliases on the `proxy` network, and its root user —
# used once, by `db-init`, to create the user below. The values are MONGO_ROOT_USERNAME and
# MONGO_ROOT_PASSWORD in nxgt-docker's database/mongo/.env.
MONGO_REPLICA_SET=rs0
MONGO_SEEDS=mongo1:27017,mongo2:27018
MONGO_ADMIN_USER=CHANGE_ME
MONGO_ADMIN_PASSWORD=CHANGE_ME

# What the order book connects as. `db-init` creates the user and sets this password on every
# `up`. Keep it hex: it goes into a connection string unencoded.   openssl rand -hex 24
ORDERS_DB_USER=spring_orders
ORDERS_DB_PASSWORD=CHANGE_ME

# The hostname is spring-orders.$HOST. Every *.localhost resolves to this machine with nothing in
# /etc/hosts. A shell that exports HOST or a TRAEFIK_* variable wins over these.
HOST=localhost
TRAEFIK_ENABLE=true
TRAEFIK_HTTP_ENTRYPOINTS=web
TRAEFIK_USE_TLS=false
