# Copy to .env (which git ignores).
#
# Which half of compose.yaml runs: `dev` mounts the checkout, compiles it and runs the jar, `prod` builds
# the executable jar into an image. Exactly one.
COMPOSE_PROFILES=dev

# The workspace's Redis, by its alias on the `proxy` network, and the database the run may use.
REDIS_HOST=redis
REDIS_DB=15
