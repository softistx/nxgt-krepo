# Copy to .env (which git ignores) and fill the CHANGE_ME. Read by the compose.yaml beside it, for
# every profile, dev and `-prod`.

# ── jpa-shop ──────────────────────────────────────────────────────────────────────────────────────
# The workspace's Postgres, by its alias on `proxy`, and its superuser — used once, by
# jpa-shop-db-init, to create the role and database below. The password is the one the server was
# started with.
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
# What the shop connects as; db-init sets this password on every `up`.   openssl rand -hex 24
SHOP_DB_NAME=shop
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=CHANGE_ME

# ── spring-orders ─────────────────────────────────────────────────────────────────────────────────
# The workspace's replica set and its root user, used once by spring-orders-db-init to create the
# user below.
MONGO_REPLICA_SET=rs0
MONGO_SEEDS=mongo1:27017,mongo2:27018
MONGO_ADMIN_USER=CHANGE_ME
MONGO_ADMIN_PASSWORD=CHANGE_ME
# What the order book connects as. Keep it hex: it goes into a connection string unencoded.
ORDERS_DB_USER=spring_orders
ORDERS_DB_PASSWORD=CHANGE_ME

# ── workflow-checkout ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_DB=15

# ── demo-client, demo-spring-client ───────────────────────────────────────────────────────────────
DEMO_API_URL=http://demo-api:8080/

# ── Traefik ───────────────────────────────────────────────────────────────────────────────────────
# Each server answers at <example>.$HOST. Every *.localhost resolves to this machine with nothing in
# /etc/hosts. A shell that exports HOST or a TRAEFIK_* variable wins over these.
HOST=localhost
TRAEFIK_ENABLE=true
TRAEFIK_HTTP_ENTRYPOINTS=web
TRAEFIK_USE_TLS=false
